{
    "version": "2.0.0",
    "tasks": [
        {
            // Fresh profile for headless testflow runs, like CI's per-test sandbox.
            // Also guards against a crashed run leaving session-restore state behind,
            // which would flip the next startup into Recovery mode.
            "label": "testflow: reset headless profile",
            "type": "shell",
            "command": "rm -rf '${config:au4.testflowProfileDir}' && mkdir -p '${config:au4.testflowProfileDir}'/{config,data,cache,state}",
            "dependsOn": ["CMake: install"],
            "problemMatcher": []
        },
        {
            "label": "testflow: run all test cases",
            "type": "shell",
            "command": "buildscripts/tools/run_testflow.sh --all",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "BUILD_DIR": "${config:au4.testflowBuildDir}" }
            },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            // Runs one test case: a script, or a .testflow series.
            // The picker requires the Command Variable extension
            "label": "testflow: run test case",
            "type": "shell",
            // Escaping the picker does not cancel the task: VS Code leaves ${input:testflowScript}
            // unsubstituted, which run_testflow.sh rejects before starting anything
            "command": "buildscripts/tools/run_testflow.sh '${input:testflowScript}'",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "BUILD_DIR": "${config:au4.testflowBuildDir}" }
            },
            "group": "test",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "testflowScript",
            "type": "command",
            "command": "extension.commandvariable.file.pickFile",
            "args": {
                // Top-level scripts and series: steps/ holds helpers, and the scripts of a series
                // cannot run on their own
                "include": "share/testflowscripts/{*.js,*.testflow}",
                "description": "Testflow test case to run"
            }
        }
    ]
}
