{
    "version": "2.0.0",
    "tasks": [
        {
            // The CMake Tools install step, made explicit so it can be sequenced below.
            "label": "CMake: install",
            "type": "cmake",
            "command": "install",
            "problemMatcher": []
        },
        {
            // Deploy the test VST3 into the user's VST3 folder (see tools/vst3-test-plugin).
            // A no-op when AU_BUILD_VST3_TEST_PLUGIN is OFF, so always safe to run.
            "label": "CMake: deploy test VST3",
            "type": "cmake",
            "command": "build",
            "targets": ["deploy_test_vst3"],
            "problemMatcher": []
        },
        {
            // Pre-launch for the Linux configs: install as before, then deploy the rebuilt
            // test plugin so editing it and pressing F5 shows the change in Audacity.
            "label": "CMake: install + deploy test VST3",
            "dependsOrder": "sequence",
            "dependsOn": ["CMake: install", "CMake: deploy test VST3"],
            "problemMatcher": []
        },
        {
            // Fresh profile for headless testflow runs, like CI's per-test sandbox.
            // Also guards against a crashed run leaving session-restore state behind,
            // which would flip the next startup into Recovery mode.
            "label": "testflow: reset headless profile",
            "type": "shell",
            "command": "rm -rf '${config:au4.testflowProfileDir}' && mkdir -p '${config:au4.testflowProfileDir}'/{config,data,cache,state}",
            "dependsOn": ["CMake: install"],
            "problemMatcher": []
        },
        {
            "label": "testflow: run all test cases",
            "type": "shell",
            "command": "buildscripts/tools/run_testflow.sh --all",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "BUILD_DIR": "${config:au4.testflowBuildDir}" }
            },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        }
    ]
}
