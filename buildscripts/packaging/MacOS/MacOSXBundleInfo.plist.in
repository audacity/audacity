<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrincipalClass</key>
    <string>NSApplication</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en-US</string>
	<!-- UTI declarations for OS X >= 10.4	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<!-- Audacity documents -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.audacityteam.aup4</string>
			<key>UTTypeDescription</key>
			<string>Audacity File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>aup4</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-audacity</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audacity File</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>aup4</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>AupIcon.icns</string>
			<key>CFBundleTypeMIMETypes</key>
			<array>
				<string>application/x-audacity</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSIsAppleDefaultForType</key>
			<true/>
			<key>LSHandlerRank</key>
   			<string>Owner</string>
		</dict>
		<!-- Keep in sync with the registered importers -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio File</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>aif</string>
				<string>aiff</string>
				<string>au</string>
				<string>avr</string>
				<string>caf</string>
				<string>flac</string>
				<string>flc</string>
				<string>htk</string>
				<string>iff</string>
				<string>ircam</string>
				<string>mat</string>
				<string>mp2</string>
				<string>mp3</string>
				<string>mpa</string>
				<string>mpc</string>
				<string>oga</string>
				<string>ogg</string>
				<string>opus</string>
				<string>paf</string>
				<string>pvf</string>
				<string>raw</string>
				<string>rf64</string>
				<string>sd2</string>
				<string>sds</string>
				<string>sf</string>
				<string>snd</string>
				<string>sv16</string>
				<string>svx</string>
				<string>svx8</string>
				<string>voc</string>
				<string>w64</string>
				<string>wav</string>
				<string>wv</string>
				<string>wve</string>
				<string>xi</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
		<!-- Additional ffmpeg supported file formats -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>FFmpeg Media File</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>302</string>
				<string>3g2</string>
				<string>3gp</string>
				<string>4xm</string>
				<string>aac</string>
				<string>ac3</string>
				<string>afc</string>
				<string>aifc</string>
				<string>al</string>
				<string>amr</string>
				<string>apc</string>
				<string>ape</string>
				<string>apl</string>
				<string>asf</string>
				<string>avi</string>
				<string>avs</string>
				<string>bethsoftvid</string>
				<string>c93</string>
				<string>cdata</string>
				<string>cgi</string>
				<string>daud</string>
				<string>dsicin</string>
				<string>dts</string>
				<string>dv</string>
				<string>dxa</string>
				<string>ea</string>
				<string>ffm</string>
				<string>film_cpk</string>
				<string>flic</string>
				<string>flv</string>
				<string>gif</string>
				<string>gxf</string>
				<string>idcin</string>
				<string>image2</string>
				<string>image2pipe</string>
				<string>ipmovie</string>
				<string>lmlm4</string>
				<string>m4a</string>
				<string>m4r</string>
				<string>m4v</string>
				<string>mac</string>
				<string>mj2</string>
				<string>mkv</string>
				<string>mm</string>
				<string>mmf</string>
				<string>mov</string>
				<string>mp4</string>
				<string>mpc8</string>
				<string>mpeg</string>
				<string>mpegtsraw</string>
				<string>mpegvideo</string>
				<string>mpg</string>
				<string>msnwctcp</string>
				<string>mtv</string>
				<string>mxf</string>
				<string>nsv</string>
				<string>nut</string>
				<string>nuv</string>
				<string>psxstr</string>
				<string>pva</string>
				<string>ra</string>
				<string>redir</string>
				<string>rl2</string>
				<string>rm</string>
				<string>roq</string>
				<string>rtsp</string>
				<string>rv</string>
				<string>s16be</string>
				<string>s8</string>
				<string>sb</string>
				<string>sdp</string>
				<string>shn</string>
				<string>siff</string>
				<string>smk</string>
				<string>sol</string>
				<string>son</string>
				<string>sw</string>
				<string>swf</string>
				<string>thp</string>
				<string>tiertexseq</string>
				<string>ts</string>
				<string>tta</string>
				<string>txd</string>
				<string>u16be</string>
				<string>u8</string>
				<string>ub</string>
				<string>ul</string>
				<string>uw</string>
				<string>vb</string>
				<string>vfwcap</string>
				<string>vmd</string>
				<string>wc3movie</string>
				<string>wma</string>
				<string>wmv</string>
				<string>wsaud</string>
				<string>wsvqa</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
		<!-- Additional project files -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audacity Project</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>aup</string>
				<string>aup3</string>
				<string>aup4unsaved</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
		<!-- Subtitle files -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Label File</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>srt</string>
				<string>txt</string>
				<string>vtt</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
	</array>

    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>org.audacityteam.audacity.audacityurl</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>audacity</string>
            </array>
        </dict>
    </array>

    <key>ATSApplicationFontsPath</key>
    <string>fonts</string>

	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>
	<key>CFBundleIconName</key>
	<string>${MACOSX_BUNDLE_ICON_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLongVersionString</key>
	<string>${MACOSX_BUNDLE_LONG_VERSION_STRING}</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>LSRequiresCarbon</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>${MACOSX_DEPLOYMENT_TARGET}</string>
	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>        
        <key>NSMicrophoneUsageDescription</key>
        <string>Audacity requires access to the microphone only if you intend to record from it.</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>
	<key>ATSApplicationFontsPath</key>
	<string>fonts/</string>
	<key>SUFeedURL</key>
	<string>${SPARKLE_APPCAST_URL}</string>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>CFBundleLocalizations</key>
	<array>
${AU4_BUNDLE_LOCALIZATIONS}	</array>
</dict>
</plist>
